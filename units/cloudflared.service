# Tunnel đọc token từ /etc/cloudflared/token (mount từ host, xem quadlet/supervisor.container.in).
# Enable sẵn trong image; chưa có token thì ConditionFileNotEmpty skip sạch. Thêm token:
#   printf '%s' '<TOKEN>' > secrets/token && chmod 600 secrets/token
#   podman exec supervisor systemctl restart cloudflared
[Unit]
Description=Cloudflare Tunnel
After=network-online.target
Wants=network-online.target
# FileNotEmpty (không phải PathExists): token rỗng -> unit bị skip sạch,
# không tính là failed, systemd vẫn 'running'.
ConditionFileNotEmpty=/etc/cloudflared/token

[Service]
# simple, KHÔNG phải notify: binary cloudflared không hỗ trợ sd_notify
# (không có NOTIFY_SOCKET) -> Type=notify treo ở 'activating' vĩnh viễn.
Type=simple
ExecStart=/usr/bin/cloudflared --no-autoupdate tunnel run --token-file /etc/cloudflared/token
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
